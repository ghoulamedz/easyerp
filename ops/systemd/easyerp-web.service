# easyERP Web systemd service
# Install: sudo cp ops/systemd/easyerp-web.service /etc/systemd/system/
# Enable: sudo systemctl enable easyerp-web
# Start:  sudo systemctl start easyerp-web

[Unit]
Description=easyERP Web
After=network.target easyerp-api.service
Requires=easyerp-api.service

[Service]
Type=simple
User=easyerp
Group=easyerp
WorkingDirectory=/home/easyerp/easyerp-web
EnvironmentFile=/home/easyerp/easyerp-web/.env
ExecStart=/home/easyerp/.nvm/current/bin/node node_modules/next/dist/bin/next start --port 3003
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
# ProtectHome hides /home, which hides both the unit's own working dir and
# the nvm Node binary it executes — so the working dir is re-exposed
# read-write and the nvm tree read-only, and nothing else is loosened.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/home/easyerp/.nvm
ReadWritePaths=/home/easyerp/easyerp-web

[Install]
WantedBy=multi-user.target