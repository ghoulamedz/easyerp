# easyERP API systemd service
# Install: sudo cp ops/systemd/easyerp-api.service /etc/systemd/system/
# Enable: sudo systemctl enable easyerp-api
# Start:  sudo systemctl start easyerp-api

[Unit]
Description=easyERP API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=easyerp
Group=easyerp
WorkingDirectory=/home/easyerp/easyerp-api
EnvironmentFile=/home/easyerp/easyerp-api/.env
ExecStart=/home/easyerp/.nvm/versions/node/v24.21.0/bin/node dist/main.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/easyerp/easyerp-api /var/lib/easyerp/documents

[Install]
WantedBy=multi-user.target