# easyERP API systemd service
# Install: sudo cp ops/systemd/easyerp-api.service /etc/systemd/system/
# Enable: sudo systemctl enable easyerp-api
# Start:  sudo systemctl start easyerp-api

[Unit]
Description=easyERP API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=easyerp
Group=easyerp
WorkingDirectory=/home/easyerp/easyerp-api
EnvironmentFile=/home/easyerp/easyerp-api/.env
ExecStart=/home/easyerp/.nvm/current/bin/node dist/main.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
# ProtectHome hides /home, which also hides the nvm Node binary this unit
# executes — so the nvm tree is re-exposed read-only, and only read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/home/easyerp/.nvm
# `ReadWritePaths=` is expected to name directories that exist, and the document
# archive directory this used to also name is gone with the archive (ADR 0010):
# no code creates it and none writes there, so it was a path the unit would have
# needed provisioned by hand for no reason. (Whether a missing entry stops the
# unit from starting could not be checked here — no system bus in the build
# environment — so this is stated as the hazard it is rather than as a measured
# failure. `systemd-analyze verify` reports nothing either way.)
ReadWritePaths=/home/easyerp/easyerp-api

[Install]
WantedBy=multi-user.target