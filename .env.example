# ---------------------------------------------------------------------------
# easyERP — local development environment
#
# `apps/api/.env` is the file the dev script reads, and it is already committed
# for this repository's local setup. This template documents what the API
# actually requires, for anyone standing a Business up by hand or reading the
# contract the process validates at startup (`apps/api/src/config/env.ts`).
#
# Only process-level wiring lives here: ports, the database, and secrets.
# Per-Business configuration (brand, legal identity, tax rates, numbering,
# terminology) is NOT here and is never mounted: it is written into the database
# by first-run setup and edited in the app by an Administrator, so pushing a new
# release can never touch a Business's settings.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database --------------------------------------------------------------
# PostgreSQL is part of each deployment's own stack (ADR 0002), never a shared
# managed instance on the production path (ADR 0013). The demo is the exception:
# it uses Neon, because a demo should not cost a server.
#
# `pnpm dev` starts PostgreSQL on 55432, not the default 5432, so a database
# already listening on 5432 does not collide with it.
DATABASE_URL=postgresql://easyerp:easyerp@localhost:55432/easyerp?schema=public

# On Neon, `DATABASE_URL` is the pooled string and migrations need the direct one.
# `scripts/direct-url.mjs` resolves this; see docs/database-migrations.md.
# DATABASE_URL_UNPOOLED=

# Connections this process may hold. Ten is right for a single-host deployment:
# raise it only alongside Postgres' own max_connections, or the extra requests
# queue instead of arriving. With a pooler in front, count the pooler's limit
# instead — this number then bounds one host's share of it.
DATABASE_POOL_MAX=10

# --- API -------------------------------------------------------------------
API_PORT=3002
API_HOST=0.0.0.0
LOG_LEVEL=info

# --- Better Auth (ADR 0007) -------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# The web app's origin. Must match where the browser actually loads the app,
# because Better Auth writes its cookies against this and rejects the origin
# otherwise. In development that is the web dev server on 3003.
BETTER_AUTH_URL=http://localhost:3003
# Origins allowed to send credentialed requests. Comma separated, no wildcards.
CORS_ORIGINS=http://localhost:3003

# --- First-run Setup (ADR 0012) -------------------------------------------
# The single-use token that opens Setup: creates the Business, the first
# Administrator, number patterns, Units and Tax Rates. Read from the host's own
# environment and never stored. Production refuses the development default:
# generate one per deployment with `openssl rand -base64 32`.
FIRST_SETUP_TOKEN=dev-first-setup-token

# --- Web -------------------------------------------------------------------
# The web app needs no environment: next.config.ts proxies /api to
# API_INTERNAL_URL, defaulting to the API's port above. A deployment sets it
# explicitly — `http://127.0.0.1:3002` for systemd on one host, or the API
# project's own domain for the Vercel demo, where the two are separate projects.
# API_INTERNAL_URL=http://127.0.0.1:3002
