# Local development environment. Read by `pnpm dev` only (`node --env-file-if-exists=.env`);
# a deployment passes its environment through the container. Nothing here is a secret.
#
# Copied to `apps/api/.env` automatically on first `pnpm dev` if that file is missing
# (fresh clone). Committed on purpose so `pnpm dev` is truly one-command (README).
#
# Points at the `easyerp` database of the PostgreSQL started by `pnpm db:up`
# (port 55432). The integration suite uses `.env.test` and `easyerp_test` instead.

NODE_ENV=development
DATABASE_URL=postgresql://easyerp:easyerp@localhost:55432/easyerp?schema=public
DATABASE_POOL_MAX=10
BETTER_AUTH_SECRET=BUo1237aLWX5Xmm3td9oP65RKNJ5W8pMu6qvrEz0lzY
BETTER_AUTH_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3003
API_HOST=127.0.0.1
API_PORT=3002

# Opens first-run Setup on a fresh database (ADR 0012). Local default only.
FIRST_SETUP_TOKEN=dev-first-setup-token
