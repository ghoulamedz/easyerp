# Integration-test environment. Committed on purpose: nothing here is a secret.
#
# The suite empties every table in this database between tests, so it points at
# `easyerp_test` — the second database on the local PostgreSQL started by
# `pnpm db:up`, never at the `easyerp` database `pnpm dev` uses.
#
# A value already present in the environment wins, which is how CI points the
# suite at its own service container. Locally you should not need to set
# anything: `pnpm db:up` then `pnpm test:integration` is enough.

NODE_ENV=test
DATABASE_URL=postgresql://easyerp:easyerp@localhost:55432/easyerp_test?schema=public
DATABASE_POOL_MAX=20
BETTER_AUTH_SECRET=integration-only-secret-not-a-real-secret-000
BETTER_AUTH_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3003
API_HOST=127.0.0.1
API_PORT=3002

# Opens first-run Setup in the integration suite (ADR 0012). Not a secret: it
# guards nothing real and is committed so the suite runs on a clean shell.
FIRST_SETUP_TOKEN=integration-first-setup-token
