{
  "name": "@easyerp/web",
  "version": "0.0.0",
  "private": true,
  "description": "easyERP web — Next.js App Router",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3003",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "echo \"@easyerp/web runs e2e via test:e2e\"",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next coverage"
  },
  "dependencies": {
    "@easyerp/contracts": "workspace:*",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.7",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
