# Caddy terminates TLS for one Business and routes to the two halves of the app.
#
# Caddy is installed natively on the host by the distro package, not run as a
# container (ADR 0013), and it is the only thing that listens on the public port.
# PostgreSQL listens on nothing but a local socket.
#
# Two rules that matter:
#   * `/api/auth/*` goes to the API first. Better Auth owns its own request
#     parsing, so nothing may consume the body before it — a proxy that buffered
#     it would break every sign-in. The route is identical to the catch-all
#     below, and is kept separate anyway so that removing it later is a
#     deliberate edit rather than a silent regression.
#   * Security headers are set here rather than only in the applications, so they
#     hold for error responses Caddy generates itself.
#
# Install:  cp infra/caddy/Caddyfile /etc/caddy/Caddyfile
# The two upstreams are the ports in systemd's units, on loopback: the API and
# the web app are never reachable from the network.

{
	email {$ACME_EMAIL:admin@easyerp.tn}
	# Zero-downtime renewals and OCSP stapling.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$EASYERP_EMAIL_DOMAIN} {
	encode zstd gzip

	request_body {
		# A document payload is small. A body this large is not an invoice.
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Better Auth first: it must receive an untouched body.
	handle /api/auth/* {
		reverse_proxy 127.0.0.1:{$API_PORT:3002}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:{$API_PORT:3002}
	}

	handle {
		reverse_proxy 127.0.0.1:{$WEB_PORT:3003}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
		# Credentials and business identifiers do not belong in an access log.
		format filter {
			wrap console
			fields {
				uri query {
					replace authorization REDACTED
				}
			}
		}
	}
}
