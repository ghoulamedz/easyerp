# Caddy terminates TLS for one Business and routes to the two halves of the app.
#
# Two rules that matter:
#   * `/api/auth/*` goes to the API container directly. Better Auth owns its own
#     request parsing, so nothing may consume the body before it — a proxy that
#     buffered it would break every sign-in.
#   * Security headers are set here rather than only in the applications, so they
#     hold for error responses Caddy generates itself.

{
	email {$ACME_EMAIL:admin@easyerp.tn}
	# Zero-downtime renewals and OCSP stapling.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$EASYERP_EMAIL_DOMAIN} {
	encode zstd gzip

	request_body {
		# A document payload is small. A body this large is not an invoice.
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Better Auth first: it must receive an untouched body.
	handle /api/auth/* {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
		# Credentials and business identifiers do not belong in an access log.
		format filter {
			wrap console
			fields {
				uri query {
					replace authorization REDACTED
				}
			}
		}
	}
}
