# Host-local secrets for one easyERP Business. Copy to `.env` on the host and fill
# in. This file is the template; `.env` must never be committed.
#
#   cd /opt/easyerp/infra/compose && cp .env.example .env

# Database password for the local Postgres container.
POSTGRES_PASSWORD=

# Signing key for sessions and tokens. Minimum 32 random bytes:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# Published port for this Business, and the certificate domain behind it.
EASYERP_PORT=4081
EASYERP_EMAIL_DOMAIN=demo.easyerp.tn

# Contact address for TLS certificate expiry notices.
ACME_EMAIL=admin@easyerp.tn

# API database pool size. Ten per container is right for a single-host
# deployment; raise it only alongside Postgres' own max_connections.
DATABASE_POOL_MAX=10
